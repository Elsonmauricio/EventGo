<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventGo</title>
    
    @* --- CSS PROFISSIONAL --- *@
    @* Bootstrap v5.3 (Padrão no .NET 9/10) *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Icones do Bootstrap (Muito útil!) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @* Google Fonts - Uma fonte moderna (Poppins) *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Se usares CSS isolado por View *@
    <link rel="stylesheet" href="~/EventGo.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @* --- NAVBAR MODERNA --- *@
        @* Usamos 'navbar-expand-lg', 'bg-white' e 'shadow-sm' para um look limpo *@
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                @* LOGÓTIPO/NOME DA MARCA *@
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-calendar-event me-2"></i>EventGo
                </a>
                
                @* Botão para Mobile *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                @* LINKS DE NAVEGAÇÃO *@
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Explorar">Explorar Eventos</a>
                        </li>
                        <li class="nav-item">
                            @* Um botão de destaque *@
                            <a class="btn btn-primary btn-sm ms-lg-2 mt-2 mt-lg-0" href="#">
                                <i class="bi bi-plus-circle me-1"></i>Criar Evento
                            </a>
                        </li>
                    </ul>
                    
                    @* Parte do Login/Registo (Identity padrão) *@
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    @* --- CONTEÚDO PRINCIPAL --- *@
    <main role="main" class="pb-3">
        @* Removemos o 'container' aqui para podermos ter secções 'full-width' na Home *@
        @RenderBody()
    </main>

    @* --- RODAPÉ PROFISSIONAL --- *@
    @* --- RODAPÉ REDUZIDO --- *@
<footer class="border-top footer text-muted bg-white py-3"> @* py-3 em vez de py-5 reduz o espaço em cima e em baixo *@
    <div class="container">
        <div class="row align-items-center"> @* Alinha tudo verticalmente ao centro *@
            
            @* Coluna 1: Logo e Copyright *@
            <div class="col-md-4 text-center text-md-start">
                <span class="fw-bold text-primary">EventGo</span> 
                <span class="ms-2 small">&copy; @DateTime.Now.Year</span>
            </div>

            @* Coluna 2: Links Rápidos (Em linha para poupar altura) *@
            <div class="col-md-4 text-center my-2 my-md-0">
                <ul class="list-inline mb-0">
                    <li class="list-inline-item"><a href="#" class="text-decoration-none text-muted small">Sobre</a></li>
                    <li class="list-inline-item ms-3"><a href="#" class="text-decoration-none text-muted small">Privacidade</a></li>
                    <li class="list-inline-item ms-3"><a href="#" class="text-decoration-none text-muted small">Termos</a></li>
                </ul>
            </div>

            @* Coluna 3: Contacto Direto *@
            <div class="col-md-4 text-center text-md-end small">
                <i class="bi bi-envelope-at me-1"></i>suporte@eventgo.pt
            </div>
            
        </div>
    </div>
</footer>

    @* --- JAVASCRIPT --- *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>