@model IEnumerable<Participante>

<h2>Participantes</h2>
<a href="/Participantes/Create" class="btn btn-primary">Novo</a>

<table class="table">
    <tr><th>Nome</th><th>Email</th><th></th></tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Nome</td>
            <td>@p.Email</td>
            <td>
                <a href="/Participantes/Edit/@p.Id">Editar</a>
                <a href="/Participantes/Delete/@p.Id">Apagar</a>
            </td>
        </tr>
    }
</table>