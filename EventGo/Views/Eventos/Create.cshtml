@model Evento

<h2>Evento</h2>

<form method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-2">
        <label>Nome</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Data</label>
        <input asp-for="Data" type="date" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Local</label>
        <input asp-for="Local" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Capacidade</label>
        <input asp-for="Capacidade" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Organizador</label>
        <select asp-for="OrganizadorId" asp-items="ViewBag.Organizadores" class="form-control"></select>
    </div>

    <button class="btn btn-success">Guardar</button>
</form>