@model IEnumerable<Evento>

<h2>Eventos</h2>

<a class="btn btn-primary mb-3" href="/Eventos/Create">Novo Evento</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Data</th>
            <th>Local</th>
            <th>Capacidade</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Data.ToShortDateString()</td>
                <td>@item.Local</td>
                <td>@item.Capacidade</td>

                <td>
                    <a class="btn btn-warning btn-sm" href="/Eventos/Edit/@item.Id">Editar</a>
                    <a class="btn btn-danger btn-sm" href="/Eventos/Delete/@item.Id">Apagar</a>
                </td>
            </tr>
        }
    </tbody>
</table>